# Supabase: Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Server-side only. Never expose this key in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SECRET_KEY=replace-with-a-long-random-string
CORS_ORIGINS=*
CURRENCY=PHP
SHOP_NAME=PrimeCut

# Optional email notifications (leave SMTP_HOST empty to log emails instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=orders@primecut.example
SHOP_NOTIFY_EMAIL=
